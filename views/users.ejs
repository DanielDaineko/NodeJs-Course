<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Users</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <a href="/">Home</a>
    <a href="/users">Users</a>
  </nav>

  <h1>Users</h1>

  <% if (users.length > 0) { %>
    <ul>
      <% users.forEach(user => { %>
        <li><%= user %></li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No users found. Please add a user first.</p>
  <% } %>
</body>
</html>